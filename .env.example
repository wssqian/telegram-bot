# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# First-time password for new users
BOT_PASSWORD=

# Third-party AI API settings (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Request options
AI_TIMEOUT=120
AI_TEMPERATURE=0.3
AI_MAX_CONTEXT_CHARS=120
AI_MAX_IMAGE_BYTES=350000
AI_RETRY_502=2

# Avoid proxy for local AI API hosts (localhost/127.x/192.168.x/10.x/172.16-31.x)
AI_BYPASS_PROXY_FOR_LOCAL=true

# Telegram API proxy (Telegram requests only)
TELEGRAM_PROXY_URL=http://127.0.0.1:7890

# Optional
DB_PATH=users.db
