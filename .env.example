# Telegram Bot Token (from @BotFather)
# Bot 会自动注册 /start /help /new /refresh /skill_* 菜单
TELEGRAM_BOT_TOKEN=

# First-time password for new users
BOT_PASSWORD=

# Third-party AI API settings (OpenAI-compatible)
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# AI behavior
AI_TIMEOUT=120
AI_TEMPERATURE=0.3
AI_STREAM=true
AI_QUEUE_WORKERS=2
AI_MAX_HISTORY_TURNS=8
AI_MAX_CONTEXT_CHARS=500
AI_MAX_IMAGE_BYTES=350000
AI_RETRY_502=2
AI_TOOL_MAX_STEPS=6
AI_ENABLE_TOOLS=true

# Avoid proxy for local AI API hosts
AI_BYPASS_PROXY_FOR_LOCAL=true

# Telegram transport tuning
TELEGRAM_PROXY_URL=http://127.0.0.1:7890
TELEGRAM_POOL_SIZE=32
TELEGRAM_CONNECT_TIMEOUT=10
TELEGRAM_READ_TIMEOUT=20
TELEGRAM_WRITE_TIMEOUT=20

# Anti-ban rate limiter
RATE_LIMIT_WINDOW_SECONDS=30
RATE_LIMIT_MAX_REQUESTS=8

# Skill / file directories
SKILLS_DIR=skills
FILES_DIR=files

# Optional
DB_PATH=users.db
